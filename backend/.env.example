# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang

# Database PostgreSQL (Supabase/local)
DATABASE_URL="postgresql://user:password@localhost:5432/kosfinder?schema=public"

# Frontend origin yang diizinkan, pisahkan dengan koma untuk multiple origin
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Set 1 jika aplikasi berjalan di belakang proxy (Vercel/Nginx)
TRUST_PROXY=0

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
